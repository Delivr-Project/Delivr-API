# Builds Delivr API from source and packages the compiled binary.
#
#   docker build -f docker/Dockerfile.build -t delivr-api .
#
# Multi-arch: the binary is cross-compiled on the build platform, so
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/Dockerfile.build .
# works without emulation.

FROM --platform=$BUILDPLATFORM oven/bun:1 AS build

ARG TARGETARCH
# Optional version embedded into the binary (defaults to package.json version)
ARG VERSION=""

WORKDIR /build

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

RUN case "$TARGETARCH" in \
        amd64) PLATFORM=linux-x64-baseline ;; \
        arm64) PLATFORM=linux-arm64 ;; \
        *) echo "Unsupported architecture: $TARGETARCH" && exit 1 ;; \
    esac \
    && bun run compile "$PLATFORM" $VERSION --no-version-tag \
    && test -f "build/bin/delivr-api-$PLATFORM" \
    && mv "build/bin/delivr-api-$PLATFORM" build/bin/delivr-api


FROM debian:stable-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 delivr \
    && useradd --system --uid 1000 --gid delivr --home-dir /opt/delivr-api --shell /usr/sbin/nologin delivr

WORKDIR /opt/delivr-api

COPY --from=build /build/build/bin/delivr-api /usr/local/bin/delivr-api
# Migrations are read from disk at startup (DLA_DB_AUTO_MIGRATE), relative to the working directory
COPY --from=build /build/drizzle/migrations ./drizzle/migrations

RUN chmod 755 /usr/local/bin/delivr-api \
    && mkdir -p data config \
    && chown -R delivr:delivr /opt/delivr-api

# Docker networks are IPv4-only by default, so binding "::" would fail
ENV DLA_API_HOST=0.0.0.0 \
    DLA_API_PORT=14123 \
    DLA_DB_CONNECTION_URL=/opt/delivr-api/data/db.sqlite \
    DLA_LOG_DIR=/opt/delivr-api/data/logs \
    DLA_CONFIG_BASE_DIR=/opt/delivr-api/config

VOLUME ["/opt/delivr-api/data", "/opt/delivr-api/config"]

USER delivr

EXPOSE 14123/tcp

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${DLA_API_PORT}/health" > /dev/null || exit 1

ENTRYPOINT ["delivr-api"]
