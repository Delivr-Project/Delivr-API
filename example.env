DLA_LOG_LEVEL=info

DLA_APP_URL=https://app.delivr.is-on.net

DLA_API_HOST=::
DLA_API_PORT=14123
DLA_DISABLE_DOCS=false

DLA_ENCRYPTION_KEY=your-32-character-encryption-key

DLA_LOG_DIR=./data/logs
DLA_CONFIG_BASE_DIR=./config

DLA_DB_CONNECTION_URL=./data/db.sqlite
DLA_DB_AUTO_MIGRATE=true

# Outbound SMTP — used for system mail such as password-reset emails.
# All optional; leave unset to disable outbound system mail.
DLA_SMTP_HOST=
DLA_SMTP_PORT=
DLA_SMTP_USERNAME=
DLA_SMTP_PASSWORD=
DLA_SMTP_FROM=
DLA_SMTP_SECURE=false