{
    "name": "delivr-api",
    "module": "index.ts",
    "type": "module",
    "version": "0.8.0",
    "private": true,
    "scripts": {
        "typecheck": "tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
        "test": "bun test",
        "dev": "bun run --watch src/index.ts",
        "db:generate": "bun db:sqlite:generate",
        "db:migrate": "bun db:sqlite:migrate",
        "db:push": "echo 'Use db:generate db:migrate instead' && exit 1 && bun scripts/db-utils && drizzle-kit push --config=drizzle/configs/drizzle.sqlite.config.ts",
        "db:sqlite:generate": "bun scripts/db-utils && drizzle-kit generate --config=drizzle/configs/drizzle.sqlite.config.ts",
        "db:sqlite:migrate": "bun scripts/db-utils && drizzle-kit migrate --config=drizzle/configs/drizzle.sqlite.config.ts",
        "db:postgresql:generate": "drizzle-kit generate --config=drizzle/configs/drizzle.postgresql.config.ts",
        "db:postgresql:migrate": "drizzle-kit migrate --config=drizzle/configs/drizzle.postgresql.config.ts",
        "db:mysql:generate": "drizzle-kit generate --config=drizzle/configs/drizzle.mysql.config.ts",
        "db:mysql:migrate": "drizzle-kit migrate --config=drizzle/configs/drizzle.mysql.config.ts",
        "compile": "bun run ./scripts/compile",
        "start": "bun run scripts/entrypoint.ts"
    },
    "devDependencies": {
        "@cleverjs/cli": "^2.3.0",
        "@hey-api/openapi-ts": "0.91.1",
        "@types/bun": "^1.3.8",
        "@types/elliptic": "^6.4.18",
        "@types/jsdom": "^27.0.0",
        "@types/nodemailer": "^7.0.9",
        "big.js": "^7.0.1",
        "drizzle-kit": "^0.31.8",
        "imap-handler": "^0.1.12"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@cleverjs/utils": "^1.1.9",
        "@hono/standard-validator": "^0.2.2",
        "@libsql/client": "^0.17.0",
        "@scalar/hono-api-reference": "^0.9.39",
        "cron": "^4.4.0",
        "drizzle-orm": "^0.45.1",
        "drizzle-zod": "^0.8.3",
        "elliptic": "^6.6.1",
        "hono": "^4.11.7",
        "hono-openapi": "^1.2.0",
        "imapflow": "^1.2.8",
        "low-level": "^1.2.5",
        "nodemailer": "^7.0.13",
        "postal-mime": "^2.7.3",
        "zod": "^4.3.6"
    }
}
