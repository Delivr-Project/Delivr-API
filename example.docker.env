# Environment for docker-compose.yml — copy to .env

# Required: 32-character key used to encrypt stored mail account credentials.
# Generate one with: openssl rand -hex 16
DLA_ENCRYPTION_KEY=

# Public URLs as reached by the browser (no trailing slash, API URL without /v1)
DELIVR_API_PUBLIC_URL=http://localhost:14123
DELIVR_APP_PUBLIC_URL=http://localhost:14128

# Host ports
DELIVR_API_PORT=14123
DELIVR_WEB_PORT=14128

# Path to a Delivr-Web checkout, only needed for "docker compose up --build"
DELIVR_WEB_PATH=../Delivr-Web

DELIVR_ENABLE_SIGNUP=false
DLA_LOG_LEVEL=info
DLA_DISABLE_DOCS=false

# Optional outbound SMTP for system mail (password resets)
DLA_SMTP_HOST=
DLA_SMTP_PORT=
DLA_SMTP_USERNAME=
DLA_SMTP_PASSWORD=
DLA_SMTP_FROM=
DLA_SMTP_SECURE=false
